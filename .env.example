# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/real_estate_db

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/SageMakerExecutionRole
REGRESSION_ENDPOINT_NAME=housing-rf-regressor
CLASSIFICATION_ENDPOINT_NAME=bank-marketing-classifier

# AWS Bedrock fallback
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# GCP / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_AGENT_ID=your-vertex-agent-id

# SEC EDGAR
EDGAR_USER_AGENT=YourName your@email.com
REAL_ESTATE_COMPANY_TICKER=PLD
REAL_ESTATE_COMPANY_CIK=0001045609
